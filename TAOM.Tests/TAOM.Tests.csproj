<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
		<PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
		<PackageReference Include="NSubstitute" Version="5.1.0" />
		<!-- Compile-time + runtime HarmonyLib (AccessTools, HarmonyPatch, HarmonyMethod) for the
		     Migration/ binding-verification suite. Main exposes Lib.Harmony as compile-only, which
		     does NOT flow transitively to consumers. We must bring the runtime asset too: TAOM.dll
		     binds to 0Harmony, Version=2.4.2.0, and reading its [HarmonyPatch] attributes at test
		     time forces that assembly to load — so 0Harmony.dll must be in the test bin. A
		     compile-only reference here suppresses the transitive runtime copy and breaks the load. -->
		<PackageReference Include="Lib.Harmony" Version="2.4.2" />
		<PackageReference Include="coverlet.collector" Version="6.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Main\TAOM.csproj" />
		<ProjectReference Include="..\Client\TAOM.Client.csproj" />
		<!-- CrashBundleWriter builds the upload ZIP with System.IO.Compression, so asserting on the
		     bundle's contents needs the same BCL assembly the production code uses. -->
		<Reference Include="System.IO.Compression" />
		<Reference Include="System.IO.Compression.FileSystem" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="$(TaomGameBin)\TaleWorlds.*.dll" Exclude="$(TaomGameBin)\TaleWorlds.Native.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>True</Private>
		</Reference>
		<!-- Private=False: GameAssemblies loads the game's own SandBox.View, and a bin copy would load a second one (duplicate-type errors). -->
		<Reference Include="$(TaomSandBoxModuleBin)\SandBox.View.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<!-- The game folder this test DLL was compiled against. GameAssemblies falls back to it when the
	     test process has neither BANNERLORD_OVERRIDE_DIR nor BANNERLORD_GAME_DIR, so the binding
	     gate loads the install the build referenced instead of skipping. A RefAsm build compiles
	     against BUTR's stubs, so it stamps the refasm-game folder that GameReferences.targets
	     (TaomWriteRefAsmGameFolder) lays out beside this DLL, never the install, and stamps its
	     TaomGameRefs mode, so GameAssemblies loads only that folder whatever the variables say.
	     Item metadata is evaluated after every property, so TaomGameRefs and TargetDir are final
	     here. -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>TaomGameFolder</_Parameter1>
			<_Parameter2 Condition="'$(TaomGameRefs)' != 'RefAsm'">$(GameFolder)</_Parameter2>
			<_Parameter2 Condition="'$(TaomGameRefs)' == 'RefAsm'">$(TargetDir)refasm-game</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>TaomGameRefs</_Parameter1>
			<_Parameter2>$(TaomGameRefs)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>


	<Import Project="..\GameReferences.targets" />
</Project>
