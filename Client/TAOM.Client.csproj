<Project Sdk="Microsoft.NET.Sdk">

	<!-- TAOM.Client (ADR-013): the client-only half of the TAOM module, TAOM's second submodule in
	     Main/_Module/SubModule.xml. A dedicated server never loads it. This project references core;
	     core (Main/TAOM.csproj) never references this project (ClientIsolationGateTests). -->
	<PropertyGroup>
		<Version>2.0.0</Version>
		<Deterministic>true</Deterministic>
		<PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
		<!-- The module whose bin this assembly deploys into; TAOM.Client is not a module of its own.
		     The agent build's -p:ModuleId= empties it, which switches the deploy below off, as for TAOM. -->
		<ModuleId>TAOM</ModuleId>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	</PropertyGroup>

	<ItemGroup>
		<!-- The game references of Main/TAOM.csproj, through GameReferences.targets properties only
		     (GameReferencesTargetsTests). The client-only bases of the 40 types that move here live in
		     TaleWorlds.GauntletUI, TaleWorlds.TwoDimension, TaleWorlds.CampaignSystem.ViewModelCollection,
		     TaleWorlds.MountAndBlade.ViewModelCollection and TaleWorlds.MountAndBlade.GauntletUI.Widgets
		     (game bin), TaleWorlds.MountAndBlade.View (Native), SandBox.View (SandBox),
		     TaleWorlds.MountAndBlade.CustomBattle (CustomBattle) and System.Windows.Forms.
		     System.Management and System.Numerics.Vectors as in Main/TAOM.csproj:16-43 (the TaleWorlds
		     assemblies bind the game's copies; SNV is the alias PolygonWidget uses). -->
		<Reference Include="$(TaomSystemManagementDll)">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(TaomSystemNumericsVectorsDll)">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
			<Aliases>SNV</Aliases>
		</Reference>
		<Reference Include="$(TaomGameBin)\TaleWorlds.*.dll" Exclude="$(TaomGameBin)\TaleWorlds.Native.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(TaomNativeModuleBin)\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(TaomSandBoxModuleBin)\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(TaomCustomBattleModuleBin)\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Drawing" />
	</ItemGroup>

	<!-- Private=False, as Main/TAOM.csproj references TAOM.Dependencies: TAOM.dll ships from Main's
	     own deploy, never from this project's output. -->
	<ItemGroup>
		<ProjectReference Include="..\Main\TAOM.csproj">
			<Private>False</Private>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
		<!-- Compile-only, as in Main/TAOM.csproj: at runtime Harmony and UIExtenderEx come from TAOM.Dependencies.
		     No IsExternalInit polyfill: TAOM.Tests sees the internals of both assemblies, and two copies
		     of the type are CS8356 there. Client code uses no init accessors or records. -->
		<PackageReference Include="Lib.Harmony" Version="2.4.2" IncludeAssets="compile" />
		<PackageReference Include="Bannerlord.UIExtenderEx" Version="2.13.3" IncludeAssets="compile" />
		<PackageReference Include="BUTR.Harmony.Analyzer" Version="1.0.1.50" PrivateAssets="all" />
		<PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TAOM.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- Deploy into the TAOM module's bin folders. Not through Bannerlord.BuildResources: its
	     CopyBinariesWindows cleans every .dll/.pdb/.config in Modules\$(ModuleId)\bin\Win64_Shipping_Client
	     before copying this project's output, which would delete TAOM.dll. Main/TAOM.csproj builds first
	     (the ProjectReference above), so its clean and its editor and server mirrors have already run.
	     Never Win64_Shipping_Server: a dedicated server must not carry this assembly, and Main/TAOM.csproj's
	     server mirror excludes it. Never Gaming.Desktop.x64_Shipping_Client: Game Pass is not supported.
	     A deploying build of Main/TAOM.csproj alone removes TAOM.Client from both client bins, so no copy is
	     left built against an older core: BuildResources' clean in Win64_Shipping_Client and the editor
	     mirror's Delete in Win64_Shipping_wEditor. ./build.ps1 builds the solution and this target
	     redeploys a fresh one. -p:DisableModuleCopy=true WITHOUT -p:ModuleId= still runs CopyBinariesWindows
	     (it cleans Win64_Shipping_Client only) and CopyModule, but skips the mirrors and this target; the
	     Steam bin then ends with a new TAOM.dll and no TAOM.Client, while the editor bin keeps an old but
	     matched pair. Pass both flags, as AGENTS.md does.
	     Visual Studio's fast up-to-date check, the no-dependencies switch, or another build can skip Main and still
	     build and deploy this project against a core TAOM.dll that differs from the installed one. The guard
	     below fails the build when the installed Win64_Shipping_Client core is missing (Main's
	     CopyBinariesWindows has already deployed it whenever this target runs, so a missing core means Main
	     was skipped), and when the core this project compiled against (its resolved ProjectReference)
	     differs by hash from the installed one or from the Win64_Shipping_wEditor copy when that exists.
	     Both deploy together from a Main rebuild. -->
	<Target Name="DeployTaomClientToTaomModule"
	        AfterTargets="Build"
	        Condition="'$(ModuleId)' != '' AND Exists('$(GameFolder)') AND '$(DisableModuleCopy)' != 'true'">
		<PropertyGroup>
			<_TaomClientModuleBin>$(GameFolder)\Modules\$(ModuleId)\bin</_TaomClientModuleBin>
			<_TaomInstalledCore>$(_TaomClientModuleBin)\Win64_Shipping_Client\TAOM.dll</_TaomInstalledCore>
			<_TaomEditorCore>$(_TaomClientModuleBin)\Win64_Shipping_wEditor\TAOM.dll</_TaomEditorCore>
		</PropertyGroup>
		<ItemGroup>
			<_TaomClientFiles Include="$(TargetPath)" />
			<_TaomClientFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
			<_TaomBuiltCore Include="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'TAOM' AND '%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'" />
		</ItemGroup>
		<Error Condition="'@(_TaomBuiltCore)' == ''"
		       Text="TAOM.Client could not find the core TAOM.dll it was built against among its resolved ProjectReference outputs, so it cannot check that the installed core matches. Rebuild TAOM (Main) together with TAOM.Client." />
		<Error Condition="!Exists('$(_TaomInstalledCore)')"
		       Text="No TAOM.dll is installed in $(_TaomClientModuleBin)\Win64_Shipping_Client, although Main deploys it before this project. Main was skipped by Visual Studio's up-to-date check, --no-dependencies, or another build. Rebuild TAOM (Main) so both deploy together, then build again." />
		<GetFileHash Files="@(_TaomBuiltCore)" Algorithm="SHA256">
			<Output TaskParameter="Hash" PropertyName="_TaomBuiltCoreHash" />
		</GetFileHash>
		<GetFileHash Files="$(_TaomInstalledCore)" Algorithm="SHA256">
			<Output TaskParameter="Hash" PropertyName="_TaomInstalledCoreHash" />
		</GetFileHash>
		<GetFileHash Files="$(_TaomEditorCore)" Algorithm="SHA256" Condition="Exists('$(_TaomEditorCore)')">
			<Output TaskParameter="Hash" PropertyName="_TaomEditorCoreHash" />
		</GetFileHash>
		<Error Condition="'$(_TaomBuiltCoreHash)' != '$(_TaomInstalledCoreHash)'"
		       Text="The TAOM.dll installed in $(_TaomClientModuleBin)\Win64_Shipping_Client differs from the core TAOM.Client was built against. Main was skipped by Visual Studio's up-to-date check, --no-dependencies, or another build. Rebuild TAOM (Main) so both deploy together, then build again." />
		<Error Condition="Exists('$(_TaomEditorCore)') AND '$(_TaomBuiltCoreHash)' != '$(_TaomEditorCoreHash)'"
		       Text="The TAOM.dll installed in $(_TaomClientModuleBin)\Win64_Shipping_wEditor differs from the core TAOM.Client was built against. Main was skipped by Visual Studio's up-to-date check, --no-dependencies, or another build. Rebuild TAOM (Main) so both deploy together, then build again." />
		<Copy SourceFiles="@(_TaomClientFiles)" DestinationFolder="$(_TaomClientModuleBin)\Win64_Shipping_Client\" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(_TaomClientFiles)" DestinationFolder="$(_TaomClientModuleBin)\Win64_Shipping_wEditor\" SkipUnchangedFiles="true" />
		<Message Importance="high" Text="TAOM.Client: deployed @(_TaomClientFiles->Count()) files into Win64_Shipping_Client and Win64_Shipping_wEditor under $(_TaomClientModuleBin)\" />
	</Target>

	<Import Project="..\GameReferences.targets" />
</Project>
